<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep real files and directories available.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Send client-side routes such as /admin to the Vite SPA entry point.
  RewriteRule ^ index.html [L]
</IfModule>
